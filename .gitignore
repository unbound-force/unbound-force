# OS files
.DS_Store
Thumbs.db

# Editor files
*.swp
*.tmp
.vscode/
.idea/

# Environment
.env*

# Go
*.exe
*.test
*.out
/unbound
vendor/
bin/

# GoReleaser build output
dist/

# Node
node_modules/

# Gaze build artifacts
.gaze/

# Unbound Force — managed by uf init
# Runtime data under .uf/ (databases, caches, locks, logs)
.uf/artifacts/
.uf/dewey/graph.db
.uf/dewey/graph.db-shm
.uf/dewey/graph.db-wal
.uf/dewey/*.lock
.uf/dewey/cache/
.uf/dewey/dewey.log
.uf/replicator/*.db
.uf/replicator/*.db-shm
.uf/replicator/*.db-wal
.uf/replicator/*.lock
# Workspace state under .uf/ (sibling clones and caches, feedback, progress)
.uf/sibling-clones/
.uf/sibling-cache/
.uf/feedback/
.uf/progress/
# Per-developer configuration and override files — never commit provider-specific model strings
.uf/config.yaml
.uf/dewey/config.yaml
.uf/review-matrix.override.yaml
.uf/model-matrix.override.yaml
# Devcontainer — OS-specific, generated by uf sandbox init
.devcontainer/
# Legacy tool directories (renamed to .uf/ in Spec 025)
.dewey/
.hive/
.unbound-force/

# Prevent stray tool directories in subdirectories
cmd/**/.opencode/
cmd/**/.uf/
cmd/**/.specify/
cmd/**/openspec/
internal/**/.opencode/
internal/**/.uf/
internal/**/.specify/
internal/**/openspec/

*.log
gateway.pid
/unbound-force
AGENTS.md
opencode.json
