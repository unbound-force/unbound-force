#!/bin/sh
# Pre-flight wrapper for the instruction linter (.uf/preflight.yaml).
#
# Lints the tree in the working directory (the checkout, or a merge-base
# worktree during soft-gate baselines) with the primary checkout's
# linter, so rules and node_modules resolution are identical for both
# runs. Exit 1 means the linter reported errors; exit 2 means the
# linter could not run (dependencies missing, runtime crash); warnings
# never fail.
#
# The dependency and runtime checks run before the linter so a missing
# or partial install, or a node without type stripping, exits 2
# (could-not-run) instead of a load failure, which node reports as
# exit 1 and would masquerade as findings. The runtime check probes the
# capability the .ts entry needs rather than comparing versions.
set -eu
root="${UF_PREFLIGHT_PROJECT_ROOT:-$PWD}"

if [ ! -f "$root/.opencode/lib/instruction-lint.ts" ]; then
  echo "instruction-lint: linter entry not found: $root/.opencode/lib/instruction-lint.ts" >&2
  exit 2
fi

if [ ! -d "$root/.opencode/node_modules" ]; then
  echo "instruction-lint: dependencies not installed - run: (cd .opencode && npm install --no-package-lock)" >&2
  exit 2
fi

for pkg in yaml zod; do
  if [ ! -f "$root/.opencode/node_modules/$pkg/package.json" ]; then
    echo "instruction-lint: dependencies not installed - run: (cd .opencode && npm install --no-package-lock)" >&2
    echo "instruction-lint: missing or incomplete package: .opencode/node_modules/$pkg" >&2
    exit 2
  fi
done

if ! node -e 'process.exit(process.features.typescript ? 0 : 1)' >/dev/null 2>&1; then
  echo "instruction-lint: node is missing or cannot run TypeScript - use a version matching engines in .opencode/package.json" >&2
  exit 2
fi

exec node "$root/.opencode/lib/instruction-lint.ts" --root "$PWD" "$@"
