{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "allow",
      "gh issue create*": "ask",
      "gh issue edit*": "ask",
      "gh issue close*": "ask",
      "gh issue comment*": "ask",
      "gh pr create*": "ask",
      "gh pr merge*": "ask",
      "gh pr close*": "ask",
      "gh pr comment*": "ask",
      "gh pr edit*": "ask",
      "gh pr review*": "ask",
      "gh api*": "allow",
      "gh api * -X POST*": "ask",
      "gh api * -X PATCH*": "ask",
      "gh api * -X PUT*": "ask",
      "gh api * -X DELETE*": "ask",
      "gh api * --method POST*": "ask",
      "gh api * --method PATCH*": "ask",
      "gh api * --method PUT*": "ask",
      "gh api * --method DELETE*": "ask",
      "gh api * -f *": "ask",
      "gh api * -F *": "ask",
      "gh api * --input*": "ask",
      "git push*": "ask",
      "git commit*": "ask",
      "rm *": "ask"
    }
  },
  "mcp": {
    "dewey": {
      "type": "local",
      "command": [
        "dewey",
        "serve",
        "--vault",
        "."
      ],
      "enabled": true
    },
    "replicator": {
      "type": "local",
      "command": [
        "replicator",
        "serve"
      ],
      "enabled": true
    }
  }
}
