{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "allow",
      "gh issue create*": "ask",
      "gh issue edit*": "ask",
      "gh issue close*": "ask",
      "gh issue comment*": "ask",
      "gh pr create*": "ask",
      "gh pr merge*": "ask",
      "gh pr close*": "ask",
      "gh pr comment*": "ask",
      "gh pr edit*": "ask",
      "gh pr review*": "ask",
      "gh api *": "allow",
      "gh api * -X POST*": "ask",
      "gh api * -X PATCH*": "ask",
      "gh api * -X PUT*": "ask",
      "gh api * -X DELETE*": "ask",
      "gh api * -X post*": "ask",
      "gh api * -X patch*": "ask",
      "gh api * -X put*": "ask",
      "gh api * -X delete*": "ask",
      "gh api * -XPOST*": "ask",
      "gh api * -XPATCH*": "ask",
      "gh api * -XPUT*": "ask",
      "gh api * -XDELETE*": "ask",
      "gh api * -Xpost*": "ask",
      "gh api * -Xpatch*": "ask",
      "gh api * -Xput*": "ask",
      "gh api * -Xdelete*": "ask",
      "gh api * --method POST*": "ask",
      "gh api * --method PATCH*": "ask",
      "gh api * --method PUT*": "ask",
      "gh api * --method DELETE*": "ask",
      "gh api * --method post*": "ask",
      "gh api * --method patch*": "ask",
      "gh api * --method put*": "ask",
      "gh api * --method delete*": "ask",
      "gh api * --method=POST*": "ask",
      "gh api * --method=PATCH*": "ask",
      "gh api * --method=PUT*": "ask",
      "gh api * --method=DELETE*": "ask",
      "gh api * --method=post*": "ask",
      "gh api * --method=patch*": "ask",
      "gh api * --method=put*": "ask",
      "gh api * --method=delete*": "ask",
      "gh api * -f *": "ask",
      "gh api * -F *": "ask",
      "gh api * --field *": "ask",
      "gh api * --field=*": "ask",
      "gh api * --raw-field *": "ask",
      "gh api * --raw-field=*": "ask",
      "gh api * --input*": "ask",
      "git push*": "ask",
      "git commit*": "ask",
      "rm *": "ask"
    }
  },
  "mcp": {
    "dewey": {
      "type": "local",
      "command": [
        "dewey",
        "serve",
        "--vault",
        "."
      ],
      "enabled": true
    },
    "replicator": {
      "type": "local",
      "command": [
        "replicator",
        "serve"
      ],
      "enabled": true
    }
  }
}
